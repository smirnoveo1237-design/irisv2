# ---------------------------------------------------------------------------
# IrisV2 - пример конфигурации. Скопируйте файл в .env и заполните значения.
# Все переменные имеют префикс IRIS_.
# ---------------------------------------------------------------------------

# Токен бота из @BotFather (обязательно)
IRIS_BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Username бота без @ (используется для разбора /command@botname)
IRIS_BOT_USERNAME=IrisTr5plbot

# Telegram ID владельцев бота через запятую (полный доступ ко всем группам)
IRIS_OWNER_IDS=8502601092

# Чат поддержки, куда уходят тикеты и апелляции (опционально)
IRIS_SUPPORT_CHAT_ID=8502601092

# --- Инфраструктура ---------------------------------------------------------
# PostgreSQL (обязательно для production)
IRIS_DATABASE_URL=postgresql+asyncpg://iris:iris@localhost:5432/iris
# Redis (пусто = встроенный in-memory кэш, подходит только для отладки)
IRIS_REDIS_URL=redis://localhost:6379/0

# Параметры compose.yaml (используются сервисами db/backup)
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris
POSTGRES_DB=iris

IRIS_ENV=dev
IRIS_LOG_LEVEL=INFO
IRIS_LOG_JSON=false
IRIS_DEFAULT_LOCALE=ru
IRIS_TIMEZONE=Europe/Moscow

# --- Webhook / Render -------------------------------------------------------
# Включите для Render: сервис принимает updates по HTTPS, а не через long polling.
IRIS_WEBHOOK_ENABLED=false
# Обычно не нужен на Render: если пусто, берётся RENDER_EXTERNAL_URL.
IRIS_WEBHOOK_URL=
# Секрет Telegram; на Render задаётся generateValue.
IRIS_WEBHOOK_SECRET=
IRIS_WEBHOOK_PATH=/telegram/webhook
# Render сам задаёт PORT; локально можно 8080.
IRIS_PORT=8080
# На бесплатном Render планировщик реже, чтобы не тратить CPU/БД.
IRIS_SCHEDULER_TICK=20
IRIS_DB_POOL_SIZE=10
IRIS_DB_MAX_OVERFLOW=20
IRIS_DB_POOL_RECYCLE=300

# --- Команды ---------------------------------------------------------------
# Префиксы команд. Вызов без префикса включается настройкой группы bare_commands.
IRIS_COMMAND_PREFIXES=!,.,$
# Слова-триггеры: "ирис профиль", "iris профиль"
IRIS_COMMAND_TRIGGERS=ирис,iris
# Максимальная длина сообщения без префикса, которое считается командой
IRIS_MAX_BARE_LENGTH=200

# --- ИИ --------------------------------------------------------------------
IRIS_AI_ENABLED=true
IRIS_AI_BASE_URL=https://api.groq.com/openai/v1
IRIS_AI_API_KEY=
IRIS_AI_MODEL=openai/gpt-oss-120b
IRIS_AI_MAX_TOKENS=600
IRIS_AI_TIMEOUT=30

# ===== AI-провайдеры (порядок: Groq -> OpenRouter -> TokenHarbor -> Pollinations -> Gemini) =====
# Ключи можно задавать как GROQ_API_KEY, так и IRIS_GROQ_API_KEY.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b

OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

TOKENHARBOR_API_KEY=
TOKENHARBOR_MODEL=deepseek-v4.1-flash:free

GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash

POLLINATIONS_MODEL=openai

# --- Резервные копии -------------------------------------------------------
IRIS_BACKUP_DIR=./backups
